  "cards": [
    {
      "dot": "rose",
      "title": "Trust model",
      "items": [
        "Clients and external systems remain outside the runtime process boundary",
        "Only a ValidatedRuntimeContract reaches the request path",
        "Handler effects cross an active module scope and capability check"
      ]
    },
    {
      "dot": "cyan",
      "title": "Request lifecycle",
      "items": [
        "Ingress parsing enforces request limits before handler execution",
        "HandlerPool leases one isolated Context and resets its request arena",
        "Response headers are validated before the server writes bytes"
      ]
    },
    {
      "dot": "amber",
      "title": "Integrity and faults",
      "items": [
        "Self-extract payload carries bytecode, contract, policy, and optional JWS",
        "Startup rejects capability, policy, source-profile, or artifact hash drift",
        "Timeouts and panics recycle or quarantine the affected runtime slot"
      ]
    }
  ]
