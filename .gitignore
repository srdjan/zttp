.zig-cache/
zig-out/
zig-pkg/
.DS_Store
*.tmp
*.o

# Claude Code harness worktrees
.claude/

# Local scratch dir — used for smoke-test databases, throwaway handler
# probes, etc. Never commit.
/temp/

# Compound-engineering scratch state (optimization specs, experiment logs).
# Local resume/audit only; never commit.
/.context/

# Demo artifacts (screencasts, recordings) and their recording scripts.
# Never commit.
/demos/

# Secrets. .env is the classic dotenv convention; .envrc is direnv's.
# Both are mentioned in docs/pi-cassettes.md and the repo's key-hygiene
# guidance, so block them at the repo level rather than relying on a
# user-level global gitignore.
.env
.envrc

# Generated files (build-time precompilation)
packages/runtime/generated/

# local scratch / experiments (should not be committed)
size_check
test_cc
test_mmap
test_mmap2
test_mprotect
test_prot
test_rand
test_time
build_link.log

# Scratch projects scaffolded by `zttp init` at repo root during ad-hoc
# CLI testing. Real example apps live under examples/.
/my-app/
.codex/skills/
proof-report.txt
proof.json
codedb.snapshot
.codegraph/

# External metadoor generator-pack scratch (consumed via
# `precompile --generator-pack`; regenerated on demand by the
# metadoor tool). Never commit.
.metadoor-*/

# Defense-in-depth: ignore any 16-char scratch dirs at repo root. The
# root cause (tests in packages/pi/src/loop.zig passing bare tmp.sub_path
# as workspace_root) was fixed by routing writes through
# .zig-cache/tmp/<sub_path>, but keep this glob in case another callsite
# regresses. No legit top-level dir in this repo is 16 chars long.
/????????????????/
docs/pi-tui-demo.gif
docs/pi-tui-demo.tape
.zttp/

# Generator output from `zts check --types`. Regenerated on demand;
# never commit.
/zttp.d.ts
demos/
.playwright-mcp/
brag-output/
brag-output-*/

# Python bytecode cache. The build runs scripts/*.py, and CPython writes this
# beside them. Left untracked it makes `git status --porcelain` non-empty, which
# is what the evidence publishers read as "the source is dirty" - so an
# unignored __pycache__ made docs/coverage.json and docs/convergence.json
# impossible to publish from a clean checkout.
__pycache__/
*.pyc
