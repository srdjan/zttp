        "queue",
        "message"
      ],
      "failureSeverity": "expected"
    },
    {
      "name": "request",
      "effect": "write",
      "returns": "result",
      "params": [
        "string",
        "unknown"
      ],
      "paramNames": [
        "queue",
        "message"
      ],
      "failureSeverity": "expected"
    },
    {
      "name": "receive",
      "effect": "write",
      "returns": "result",
      "params": [
        "string"
      ],
      "paramNames": [
        "queue"
      ],
      "failureSeverity": "expected"
    },
    {
      "name": "ack",
      "effect": "write",
      "returns": "result",
      "params": [
        "string"
      ],
      "paramNames": [
        "messageId"
      ],
      "failureSeverity": "expected"
    },
    {
