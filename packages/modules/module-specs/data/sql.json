{
  "schemaVersion": 1,
  "specifier": "zttp:sql",
  "source": "packages/modules/src/data/sql.zig",
  "summary": "Register every statement once with sql(name, statement) at module scope, then execute it by that name: the first argument of sqlOne, sqlMany, and sqlExec is the registered name, never SQL text. Bind values as named parameters like :id.",
  "requiredCapabilities": [
    "sqlite",
    "policy_check"
  ],
  "exports": [
    {
      "name": "sql",
      "effect": "write",
      "returns": "boolean",
      "params": [
        "string",
        "string"
      ],
      "paramNames": [
        "name",
        "statement"
      ],
      "requiredCapabilities": [],
      "contractExtractions": [
        {
          "category": "sql_registration"
        }
      ]
    },
    {
      "name": "sqlOne",
      "effect": "read",
      "returns": "optional_object",
      "params": [
        "string",
        "object"
      ],
      "paramNames": [
        "name",
        "params"
      ],
      "failureSeverity": "expected"
    },
    {
      "name": "sqlMany",
      "effect": "read",
      "returns": "object",
      "params": [
        "string",
        "object"
      ],
      "paramNames": [
        "name",
        "params"
      ]
    },
    {
      "name": "sqlExec",
      "effect": "write",
      "returns": "object",
      "params": [
        "string",
        "object"
      ],
      "paramNames": [
        "name",
        "params"
      ]
    }
  ]
}
